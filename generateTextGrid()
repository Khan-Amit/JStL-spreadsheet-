// ==================== UNIFIED DOWNLOAD FUNCTIONS ====================
function generateTextGrid() {
    let country = document.title.replace('JStL ', '');
    let income = document.getElementById('annualIncome').value;
    let lines = [];
    
    // Top border
    lines.push('+' + '-'.repeat(78) + '+');
    
    // Title line
    let title = ' JStL Spreadsheet™ - ' + country;
    lines.push('|' + title + ' '.repeat(78 - title.length) + '|');
    
    // Date line
    let dateStr = ' Generated: ' + new Date().toLocaleString();
    lines.push('|' + dateStr + ' '.repeat(78 - dateStr.length) + '|');
    
    // Separator
    lines.push('+' + '-'.repeat(32) + '+' + '-'.repeat(30) + '+' + '-'.repeat(14) + '+');
    
    // Header
    lines.push('|' + ' CATEGORY'.padEnd(32) + '|' + ' ITEM'.padEnd(30) + '|' + ' VALUE'.padEnd(14) + '|');
    
    // Separator
    lines.push('+' + '-'.repeat(32) + '+' + '-'.repeat(30) + '+' + '-'.repeat(14) + '+');
    
    // Input row
    lines.push('|' + ' INPUTS'.padEnd(32) + '|' + ' Annual Income'.padEnd(30) + '|' + (' ' + income).padEnd(14) + '|');
    
    // Separator before results
    lines.push('+' + '-'.repeat(32) + '+' + '-'.repeat(30) + '+' + '-'.repeat(14) + '+');
    
    // Get tax result text (clean first 3 lines)
    let taxText = document.getElementById('taxResult').innerText || '';
    let taxLines = taxText.split('\n');
    for(let i = 0; i < Math.min(taxLines.length, 4); i++) {
        let line = taxLines[i].substring(0, 28);
        if(line.trim().length > 0) {
            lines.push('|' + ' RESULTS'.padEnd(32) + '|' + (' ' + line).padEnd(30) + '|' + ' '.padEnd(14) + '|');
        }
    }
    
    // Demography line
    let demoText = document.getElementById('demographyResult').innerText || '';
    let demoLines = demoText.split('\n');
    for(let i = 0; i < Math.min(demoLines.length, 2); i++) {
        let line = demoLines[i].substring(0, 28);
        if(line.trim().length > 0) {
            lines.push('|' + ' DEMOGRAPHY'.padEnd(32) + '|' + (' ' + line).padEnd(30) + '|' + ' '.padEnd(14) + '|');
        }
    }
    
    // Bottom border
    lines.push('+' + '-'.repeat(78) + '+');
    
    // License line
    let license = ' JStL Spreadsheet™ — Perpetual License';
    lines.push('|' + license + ' '.repeat(78 - license.length) + '|');
    
    // Email line
    let email = ' 📧 amit.khanna.1082@gmail.com | seliim.ahmed@gmail.com';
    lines.push('|' + email + ' '.repeat(78 - email.length) + '|');
    
    // Bottom border
    lines.push('+' + '-'.repeat(78) + '+');
    
    return lines.join('\n');
}

function downloadTxt() {
    let content = generateTextGrid();
    let blob = new Blob([content], {type: "text/plain;charset=utf-8"});
    let link = document.createElement('a');
    let url = URL.createObjectURL(blob);
    link.href = url;
    let country = document.title.replace('JStL ', '').replace(' ', '_');
    link.download = `JStL_${country}_${Date.now()}.jstl`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    alert('✅ Saved as text grid');
}

function downloadHtml() {
    let country = document.title.replace('JStL ', '');
    let income = document.getElementById('annualIncome').value;
    let taxResult = document.getElementById('taxResult').innerHTML || '';
    let demoResult = document.getElementById('demographyResult').innerHTML || '';
    let html = `<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>JStL ${country}</title>
    <style>
        body{background:#0a1a2f;font-family:monospace;padding:20px}
        h1{color:#7abfef}
        table{border-collapse:collapse;width:100%;margin-top:20px}
        th,td{border:1px solid #2a5a7a;padding:10px;background:#0f2e44;color:#e0f0ff}
        th{background:#071a2b;color:#7abfef}
        .footer{text-align:center;color:#6a9ec0;margin-top:20px}
    </style>
</head>
<body>
    <h1>JStL Spreadsheet™ - ${country}</h1>
    <h3>Generated: ${new Date().toLocaleString()}</h3>
    <table>
        <thead><tr><th>Category</th><th>Details</th></tr></thead>
